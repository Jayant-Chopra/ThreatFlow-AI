generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  uploadPath  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  scans       Scan[]
}

model Scan {
  id          String    @id @default(cuid())
  projectId   String
  status      String
  summary     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project   @relation(fields: [projectId], references: [id])
  findings    Finding[]
}

model Finding {
  id          String   @id @default(cuid())
  scanId      String
  type        String
  severity    String
  file        String
  line        Int
  source      String
  sink        String
  route       String?
  evidence   String?
  createdAt   DateTime @default(now())
  scan        Scan     @relation(fields: [scanId], references: [id])
}
